{
  "$description": "The colour slot declarations: per family the options, parts and the rest role of each property; per component the parts that read a family, the options and states they paint; the variants that are no family option; and each exception with the decision that grants it. scripts/lib/core/color-slots.ts:readColorSlots(root) derives every slot from them, and check:color-slots holds both.",
  "accepts": {
    "fill": [
      "emphasis-*-fill",
      "emphasis-*-fill-hover",
      "fill-*",
      "hue-*-fill-strong",
      "hue-*-fill-soft",
      "accent-*-fill-soft",
      "transparent"
    ],
    "ink": [
      "emphasis-*-ink",
      "ink-*",
      "hue-*-ink",
      "hue-*-on-ink",
      "accent-*-ink",
      "accent-*-quiet-ink"
    ],
    "edge": [
      "emphasis-*-edge",
      "emphasis-*-icon-edge",
      "edge-*",
      "hue-*-edge",
      "accent-*-edge",
      "accent-*-side-edge",
      "transparent"
    ],
    "icon": [
      "emphasis-*-ink",
      "ink-*",
      "hue-*-ink",
      "hue-*-on-ink",
      "accent-*-ink",
      "accent-*-quiet-ink"
    ]
  },
  "refused": [
    "edge-focus"
  ],
  "states": [
    "rest",
    "hover",
    "pressed",
    "selected",
    "selected-hover",
    "selected-pressed",
    "disabled",
    "selected-disabled"
  ],
  "stateSets": {
    "rest": [
      "rest"
    ],
    "base": [
      "rest",
      "hover",
      "pressed",
      "disabled"
    ],
    "selectable": [
      "rest",
      "hover",
      "pressed",
      "disabled",
      "selected",
      "selected-hover",
      "selected-pressed",
      "selected-disabled"
    ]
  },
  "selected": {
    "fill": {
      "role": "{fill-selected}",
      "level": "level-accent-soft-primary"
    },
    "ink": {
      "role": "{ink-selected}"
    },
    "edge": {
      "role": "{edge-selected}"
    }
  },
  "families": {
    "emphasis": {
      "channel": "--arena-emphasis-{property}",
      "options": {
        "primary": {
          "states": "base",
          "parts": {
            "root": {
              "fill": "{emphasis-primary-fill}",
              "ink": "{emphasis-primary-ink}",
              "edge": "{emphasis-primary-edge}",
              "icon": "ink"
            }
          }
        },
        "secondary": {
          "states": "base",
          "parts": {
            "root": {
              "fill": "{emphasis-secondary-fill}",
              "ink": "{emphasis-secondary-ink}",
              "edge": "{emphasis-secondary-edge}",
              "icon": "ink"
            }
          }
        },
        "ghost": {
          "states": {
            "edge": "base",
            "*": "selectable"
          },
          "parts": {
            "root": {
              "fill": "transparent",
              "ink": {
                "role": "{emphasis-ghost-ink}",
                "level": "level-ink-body"
              },
              "edge": "transparent",
              "icon": "ink"
            }
          }
        },
        "solid": {
          "states": "selectable",
          "parts": {
            "root": {
              "fill": "{emphasis-solid-fill}",
              "ink": "{emphasis-solid-ink}",
              "icon": "ink"
            }
          }
        }
      }
    }
  },
  "variants": {
    "destructive": {
      "decision": "R6",
      "rest": {
        "fill": "{hue-danger-fill-strong}",
        "ink": "{hue-danger-ink}",
        "edge": "{hue-danger-edge}",
        "icon": "ink"
      }
    }
  },
  "components": {
    "ArenaButton": {
      "root": {
        "family": "emphasis",
        "options": [
          "primary",
          "secondary",
          "ghost"
        ],
        "states": "base",
        "variants": [
          "destructive"
        ]
      }
    },
    "ArenaSplitButton": {
      "primary": {
        "family": "emphasis",
        "options": [
          "primary",
          "secondary",
          "ghost"
        ],
        "states": "base",
        "variants": [
          "destructive"
        ]
      },
      "caret": {
        "family": "emphasis",
        "options": [
          "primary",
          "secondary",
          "ghost"
        ],
        "states": "base",
        "variants": [
          "destructive"
        ]
      }
    },
    "ArenaFileInput": {
      "trigger": {
        "family": "emphasis",
        "options": [
          "secondary",
          "ghost"
        ],
        "states": [
          "rest",
          "hover",
          "pressed"
        ]
      }
    },
    "ArenaIconButton": {
      "root": {
        "family": "emphasis",
        "options": [
          "ghost",
          "solid"
        ],
        "states": "selectable",
        "edgeChannel": "--arena-emphasis-icon-edge",
        "own": {
          "edge": {
            "ghost": "{emphasis-ghost-icon-edge}",
            "solid": "transparent",
            "decision": "D21"
          }
        }
      }
    },
    "ArenaCopyButton": {
      "root": {
        "draws": "ArenaIconButton.root",
        "states": "base"
      }
    }
  },
  "exceptions": {
    "emphasis-secondary-root-fill-hover": {
      "default": "{emphasis-secondary-fill-hover}",
      "decision": "D19"
    },
    "emphasis-ghost-root-fill-hover": {
      "default": "{emphasis-ghost-fill-hover}",
      "decision": "D19"
    },
    "button-destructive-root-fill-hover": {
      "default": "{fill-hover}",
      "decision": "R6"
    },
    "split-button-destructive-primary-fill-hover": {
      "default": "{fill-hover}",
      "decision": "R6"
    },
    "split-button-destructive-caret-fill-hover": {
      "default": "{fill-hover}",
      "decision": "R6"
    }
  },
  "rings": {
    "ArenaButton.root": "ground",
    "ArenaIconButton.root": "ground",
    "ArenaSplitButton.primary": "ground",
    "ArenaSplitButton.caret": "ground",
    "ArenaFileInput.trigger": "ground"
  }
}