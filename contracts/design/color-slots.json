{
  "$description": "The colour slot declarations: the groups (their parts, the properties each paints, its options and states, and the rest role of each property where a group part is read), the members (every coloured part of every manifest mapped onto a group part, or null when it paints only current or transparent), and each exception with the decision that grants it. scripts/lib/core/color-slots.ts:readColorSlots(root) derives every slot from them, and check:color-slots holds both.",
  "accepts": {
    "fill": [
      "emphasis-*-fill",
      "emphasis-*-fill-hover",
      "fill-*",
      "hue-*-fill-strong",
      "hue-*-fill-soft",
      "accent-*-fill-soft",
      "transparent"
    ],
    "ink": [
      "emphasis-*-ink",
      "ink-*",
      "hue-*-ink",
      "hue-*-on-ink",
      "accent-*-ink",
      "accent-*-quiet-ink"
    ],
    "edge": [
      "emphasis-*-edge",
      "emphasis-*-icon-edge",
      "edge-*",
      "hue-*-edge",
      "accent-*-edge",
      "accent-*-side-edge",
      "transparent"
    ],
    "icon": [
      "emphasis-*-ink",
      "ink-*",
      "hue-*-ink",
      "hue-*-on-ink",
      "accent-*-ink",
      "accent-*-quiet-ink"
    ]
  },
  "refused": [
    "edge-focus"
  ],
  "states": [
    "rest",
    "hover",
    "pressed",
    "selected",
    "selected-hover",
    "selected-pressed",
    "disabled",
    "selected-disabled"
  ],
  "stateSets": {
    "rest": [
      "rest"
    ],
    "base": [
      "rest",
      "hover",
      "pressed",
      "disabled"
    ],
    "selectable": [
      "rest",
      "hover",
      "pressed",
      "disabled",
      "selected",
      "selected-hover",
      "selected-pressed",
      "selected-disabled"
    ],
    "static": [
      "rest"
    ],
    "static-disabled": [
      "rest",
      "disabled"
    ],
    "toggle": [
      "rest",
      "selected",
      "disabled",
      "selected-disabled"
    ]
  },
  "selected": {
    "fill": {
      "role": "{fill-selected}",
      "level": "level-accent-soft-primary"
    },
    "ink": {
      "role": "{ink-selected}"
    },
    "edge": {
      "role": "{edge-selected}"
    }
  },
  "exceptions": {
    "actions-secondary-root-fill-hover": {
      "default": "{emphasis-secondary-fill-hover}",
      "decision": "D19"
    },
    "actions-ghost-root-fill-hover": {
      "default": "{emphasis-ghost-fill-hover}",
      "decision": "D19"
    },
    "actions-destructive-root-fill-hover": {
      "default": "{fill-hover}",
      "decision": "R6"
    }
  },
  "rings": {
    "ArenaButton.root": "ground",
    "ArenaIconButton.root": "ground",
    "ArenaSplitButton.primary": "ground",
    "ArenaSplitButton.caret": "ground",
    "ArenaFileInput.trigger": "ground"
  },
  "groups": {
    "actions": {
      "parts": {
        "root": {
          "properties": [
            "fill",
            "ink",
            "edge",
            "icon"
          ],
          "channel": "--arena-emphasis-{property}",
          "options": {
            "primary": {
              "states": "base",
              "rest": {
                "fill": "{emphasis-primary-fill}",
                "ink": "{emphasis-primary-ink}",
                "edge": "{emphasis-primary-edge}",
                "icon": "ink"
              }
            },
            "secondary": {
              "states": "base",
              "rest": {
                "fill": "{emphasis-secondary-fill}",
                "ink": "{emphasis-secondary-ink}",
                "edge": "{emphasis-secondary-edge}",
                "icon": "ink"
              }
            },
            "ghost": {
              "states": "selectable",
              "rest": {
                "fill": "transparent",
                "ink": {
                  "role": "{emphasis-ghost-ink}",
                  "level": "level-ink-body"
                },
                "edge": "transparent",
                "icon": "ink"
              }
            },
            "solid": {
              "states": "selectable",
              "rest": {
                "fill": "{emphasis-solid-fill}",
                "ink": "{emphasis-solid-ink}",
                "edge": "transparent",
                "icon": "ink"
              }
            },
            "destructive": {
              "states": "base",
              "channel": null,
              "rest": {
                "fill": "{hue-danger-fill-strong}",
                "ink": "{hue-danger-ink}",
                "edge": "{hue-danger-edge}",
                "icon": "ink"
              },
              "decision": "R6"
            }
          }
        },
        "dismiss": {
          "properties": [
            "fill",
            "ink",
            "icon"
          ],
          "states": "base"
        }
      }
    },
