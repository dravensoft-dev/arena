{
  "families": [
    {
      "family": "witness",
      "reach": "context",
      "description": "A context family declared by this fixture alone, so a context reach is measured before Arena ships one.",
      "default": "arena-witness-off",
      "variants": {
        "arena-witness-on": "[--arena-witness-mark:1]",
        "arena-witness-off": "[--arena-witness-mark:0]"
      },
      "parts": [
        "button"
      ]
    },
    {
      "family": "boxwitness",
      "reach": "box",
      "description": "A box family declared by this fixture alone, answered by a card and a button, so a channel written on a component is measured not to reach the content it projects.",
      "default": "arena-boxwitness-off",
      "variants": {
        "arena-boxwitness-on": "[--arena-boxwitness-mark:1]",
        "arena-boxwitness-off": "[--arena-boxwitness-mark:0]"
      },
      "parts": [
        "card",
        "button"
      ]
    }
  ],
