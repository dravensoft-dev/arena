{
  "family": "accent",
  "reach": "box",
  "description": "Which editorial colour a component wears when nothing it says calls for a hue. Accent carries no meaning, so a status a component states always wins over it: a success badge stays success whatever accent it is given. ink paints the ink of the surface the component sits on, which is what a spinner on a filled banner needs.",
  "default": "arena-accent-plain",
  "variants": {
    "arena-accent-plain": "[--arena-accent-edge:var(--accent-plain-edge)] [--arena-accent-feedback-banner-edge:var(--feedback-plain-banner-edge-rest,var(--accent-plain-side-edge))] [--arena-accent-marks-label-ink:var(--marks-plain-label-ink-rest,var(--accent-plain-ink))] [--arena-accent-marks-outline-edge:var(--marks-plain-outline-edge-rest,var(--accent-plain-edge))] [--arena-accent-marks-outline-ink:color-mix(in_oklab,var(--marks-plain-outline-ink-rest,var(--accent-plain-quiet-ink))_var(--level-ink-quiet),transparent)] [--arena-accent-marks-soft-fill:var(--marks-plain-soft-fill-rest,var(--accent-plain-fill-soft))] [--arena-accent-marks-soft-ink:color-mix(in_oklab,var(--marks-plain-soft-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)]",
    "arena-accent-primary": "[--arena-accent-edge:var(--accent-primary-edge)] [--arena-accent-marks-dot-ink:var(--marks-primary-dot-ink-rest,var(--accent-primary-ink))] [--arena-accent-marks-label-ink:var(--marks-primary-label-ink-rest,var(--accent-primary-ink))] [--arena-accent-marks-outline-edge:var(--marks-primary-outline-edge-rest,var(--accent-primary-edge))] [--arena-accent-marks-outline-ink:var(--marks-primary-outline-ink-rest,var(--accent-primary-ink))] [--arena-accent-marks-soft-fill:color-mix(in_oklab,var(--marks-primary-soft-fill-rest,var(--accent-primary-fill-soft))_var(--level-accent-soft-primary),transparent)] [--arena-accent-marks-soft-ink:color-mix(in_oklab,var(--marks-primary-soft-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)] [--arena-accent-meters-track-fill:var(--meters-primary-track-fill-rest,var(--fill-track))] [--arena-accent-meters-track-ink:var(--meters-primary-track-ink-rest,var(--accent-primary-ink))]",
    "arena-accent-gold": "[--arena-accent-feedback-banner-edge:var(--feedback-gold-banner-edge-rest,var(--accent-gold-side-edge))] [--arena-accent-marks-dot-ink:var(--marks-gold-dot-ink-rest,var(--accent-gold-ink))] [--arena-accent-marks-label-ink:var(--marks-gold-label-ink-rest,var(--accent-gold-ink))] [--arena-accent-marks-soft-fill:color-mix(in_oklab,var(--marks-gold-soft-fill-rest,var(--accent-gold-fill-soft))_var(--level-accent-soft-gold),transparent)] [--arena-accent-marks-soft-ink:color-mix(in_oklab,var(--marks-gold-soft-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)] [--arena-accent-meters-track-fill:var(--meters-gold-track-fill-rest,var(--fill-track))] [--arena-accent-meters-track-ink:var(--meters-gold-track-ink-rest,var(--accent-gold-ink))]",
    "arena-accent-muted": "[--arena-accent-meters-track-ink:color-mix(in_oklab,var(--meters-muted-track-ink-rest,var(--accent-muted-ink))_var(--level-ink-muted),transparent)]",
    "arena-accent-ink": "[--arena-accent-meters-track-ink:currentColor]"
  }
}
