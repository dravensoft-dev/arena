{
  "family": "accent",
  "reach": "box",
  "description": "Which editorial colour a component wears when nothing it says calls for a hue. Accent carries no meaning, so a status a component states always wins over it: a success badge stays success whatever accent it is given. ink paints the ink of the surface the component sits on, which is what a spinner on a filled banner needs.",
  "default": "arena-accent-plain",
  "variants": {
    "arena-accent-plain": "[--arena-accent-fill-soft:var(--accent-plain-fill-soft)] [--arena-accent-ink:var(--accent-plain-ink)] [--arena-accent-quiet-ink:color-mix(in_oklab,var(--accent-plain-quiet-ink)_var(--level-ink-quiet),transparent)] [--arena-accent-edge:var(--accent-plain-edge)] [--arena-accent-feedback-banner-edge:var(--feedback-plain-banner-edge-rest,var(--accent-plain-side-edge))]",
    "arena-accent-primary": "[--arena-accent-fill-soft:color-mix(in_oklab,var(--accent-primary-fill-soft)_var(--level-accent-soft-primary),transparent)] [--arena-accent-ink:var(--accent-primary-ink)] [--arena-accent-quiet-ink:var(--accent-primary-ink)] [--arena-accent-edge:var(--accent-primary-edge)] [--arena-accent-marks-dot-ink:var(--marks-primary-dot-ink-rest,var(--accent-primary-ink))] [--arena-accent-meters-track-fill:var(--meters-primary-track-fill-rest,var(--fill-track))] [--arena-accent-meters-track-ink:var(--meters-primary-track-ink-rest,var(--accent-primary-ink))]",
    "arena-accent-gold": "[--arena-accent-fill-soft:color-mix(in_oklab,var(--accent-gold-fill-soft)_var(--level-accent-soft-gold),transparent)] [--arena-accent-ink:var(--accent-gold-ink)] [--arena-accent-feedback-banner-edge:var(--feedback-gold-banner-edge-rest,var(--accent-gold-side-edge))] [--arena-accent-marks-dot-ink:var(--marks-gold-dot-ink-rest,var(--accent-gold-ink))] [--arena-accent-meters-track-fill:var(--meters-gold-track-fill-rest,var(--fill-track))] [--arena-accent-meters-track-ink:var(--meters-gold-track-ink-rest,var(--accent-gold-ink))]",
    "arena-accent-muted": "[--arena-accent-ink:color-mix(in_oklab,var(--accent-muted-ink)_var(--level-ink-muted),transparent)] [--arena-accent-meters-track-ink:color-mix(in_oklab,var(--meters-muted-track-ink-rest,var(--accent-muted-ink))_var(--level-ink-muted),transparent)]",
    "arena-accent-ink": "[--arena-accent-ink:currentColor] [--arena-accent-meters-track-ink:currentColor]"
  }
}
