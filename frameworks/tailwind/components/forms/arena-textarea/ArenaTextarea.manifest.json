{
  "component": "ArenaTextarea",
  "slots": {
    "root": "flex flex-col gap-1.5",
    "label": "font-face-label text-ctl-xs tracking-label-role case-label text-ink-muted/(--level-ink-muted)",
    "required": "ml-1 text-[color:var(--fields-required-ink-rest,var(--accent-primary-ink))]",
    "field": "w-full px-control-x py-control-text-y border-[length:var(--bw-field)] rounded-field font-body text-ctl leading-body outline-none transition-[border-color,box-shadow] duration-[var(--dur-hover)] ease-hover placeholder:text-[color:color-mix(in_oklab,var(--fields-value-ink-rest,var(--ink-body))_var(--level-ink-muted),transparent)] text-[color:var(--fields-value-ink-rest,var(--ink-body))]",
    "foot": "flex justify-between gap-items",
    "hint": "font-body text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "error": "font-body text-ctl-sm text-[color:var(--fields-error-ink-rest,var(--ink-invalid))]",
    "counter": "font-mono text-ctl-xs"
  },
  "kind": {
    "root": "none",
    "label": "none",
    "required": "none",
    "field": "field",
    "foot": "none",
    "hint": "none",
    "error": "none",
    "counter": "none"
  },
  "internal": {
    "state": "error when error is given",
    "resize": "none while autoResize grows the field, vertical otherwise",
    "near": "the length is past 90% of maxLength"
  },
  "variants": {
    "state": {
      "neutral": {
        "field": "focus:border-edge-focus focus:ring-[length:var(--bw-focus)] focus:ring-edge-focus/(--level-accent-soft-gold) disabled:border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))] hover:border-[color:var(--fields-neutral-field-edge-hover,var(--fields-neutral-field-edge-rest,var(--edge-field)))] border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] disabled:bg-[color:var(--fields-neutral-field-fill-disabled,var(--fields-neutral-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-neutral-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-neutral-field-fill-rest,var(--fill-field))] disabled:opacity-[var(--fields-neutral-field-fade-disabled,var(--fade-disabled))]"
      },
      "error": {
        "field": "ring-[length:var(--focus-width)] disabled:border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))] hover:border-[color:var(--fields-error-field-edge-hover,var(--fields-error-field-edge-rest,var(--edge-invalid)))] border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] disabled:bg-[color:var(--fields-error-field-fill-disabled,var(--fields-error-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-error-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-error-field-fill-rest,var(--fill-field))] ring-[color:color-mix(in_oklab,var(--fields-error-field-edge-rest,var(--edge-invalid))_var(--level-hue-soft-danger),transparent)] disabled:opacity-[var(--fields-error-field-fade-disabled,var(--fade-disabled))]"
      }
    },
    "resize": {
      "vertical": {
        "field": "resize-y"
      },
      "none": {
        "field": "resize-none"
      }
    },
    "disabled": {
      "true": {
        "label": "opacity-[var(--fade-disabled)]",
        "hint": "opacity-[var(--fade-disabled)]",
        "error": "opacity-[var(--fade-disabled)]",
        "counter": "opacity-[var(--fade-disabled)]"
      },
      "false": {}
    },
    "readOnly": {
      "true": {
        "field": "cursor-default disabled:bg-[color:var(--fields-readonly-field-fill-disabled,var(--fields-readonly-field-fill-rest,var(--fill-surface)))] bg-[color:var(--fields-readonly-field-fill-rest,var(--fill-surface))] hover:bg-[color:var(--fields-readonly-field-fill-rest,var(--fill-surface))] disabled:opacity-[var(--fields-readonly-field-fade-disabled,var(--fade-disabled))]"
      },
      "false": {}
    },
    "near": {
      "true": {
        "counter": "text-[color:var(--fields-warning-counter-ink-rest,var(--hue-warning-ink))]"
      },
      "false": {
        "counter": "text-[color:color-mix(in_oklab,var(--fields-neutral-counter-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]"
      }
    }
  },
  "defaultVariants": {
    "state": "neutral",
    "resize": "vertical",
    "disabled": false,
    "readOnly": false,
    "near": false
  },
  "compoundVariants": [
    {
      "readOnly": true,
      "state": "neutral",
      "class": {
        "field": "hover:border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] disabled:border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))]"
      }
    },
    {
      "readOnly": true,
      "state": "error",
      "class": {
        "field": "hover:border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] disabled:border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))]"
      }
    }
  ]
}
