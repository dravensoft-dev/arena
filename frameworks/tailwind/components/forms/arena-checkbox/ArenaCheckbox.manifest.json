{
  "component": "ArenaCheckbox",
  "slots": {
    "root": "relative inline-flex items-center min-h-ctl-h-sm gap-2.5 w-fit",
    "box": "inline-flex items-center justify-center size-5 rounded-control-sm border-[length:var(--bw-control)] transition-[background] duration-[var(--dur-hover)] ease-hover [&:has(~input:focus-visible)]:shadow-[0_0_0_var(--bw-focus)_var(--edge-focus)] border-[color:var(--choices-box-edge-rest,var(--edge-control))] bg-[color:var(--choices-box-fill-rest,var(--fill-control))]",
    "check": "size-3 [stroke-width:var(--bw-strong)] text-[color:var(--choices-mark-ink-selected,var(--emphasis-primary-ink))]",
    "label": "font-body text-ctl text-ink-body/(--level-ink-body)",
    "input": "absolute opacity-0 size-0",
    "group": "flex flex-col gap-items"
  },
  "kind": {
    "root": "none",
    "box": "control",
    "check": "none",
    "label": "none",
    "input": "none",
    "group": "none"
  },
  "variants": {
    "checked": {
      "true": {
        "box": "border-[color:var(--choices-box-edge-selected,transparent)] bg-[color:var(--choices-box-fill-selected,var(--fill-control-on))]"
      },
      "false": {}
    },
    "disabled": {
      "true": {
        "root": "opacity-[var(--fade-disabled)] cursor-not-allowed",
        "box": "border-[color:var(--choices-box-edge-disabled,var(--choices-box-edge-rest,var(--edge-control)))] bg-[color:var(--choices-box-fill-disabled,var(--choices-box-fill-rest,var(--fill-control)))]",
        "check": "text-[color:var(--choices-mark-ink-selected-disabled,var(--choices-mark-ink-selected,var(--emphasis-primary-ink)))]"
      },
      "false": {
        "root": "cursor-pointer"
      }
    }
  },
  "compoundVariants": [
    {
      "checked": true,
      "disabled": true,
      "class": {
        "box": "border-[color:var(--choices-box-edge-selected-disabled,var(--choices-box-edge-selected,transparent))] bg-[color:var(--choices-box-fill-selected-disabled,var(--choices-box-fill-selected,var(--fill-control-on)))]"
      }
    }
  ],
  "defaultVariants": {
    "checked": false,
    "disabled": false
  }
}
