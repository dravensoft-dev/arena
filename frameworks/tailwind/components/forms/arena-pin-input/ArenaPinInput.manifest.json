{
  "component": "ArenaPinInput",
  "slots": {
    "root": "flex flex-col gap-1.5 min-w-0",
    "label": "font-face-label text-ctl-xs tracking-label-role case-label text-ink-muted/(--level-ink-muted)",
    "required": "ml-1 text-[color:var(--fields-required-ink-rest,var(--accent-primary-ink))]",
    "group": "flex items-center gap-inline min-w-0",
    "cell": "size-ctl-h min-w-0 shrink p-0 text-center border-[length:var(--bw-field)] rounded-field outline-none font-mono tabular-nums text-ctl transition-[border-color,box-shadow] duration-[var(--dur-hover)] ease-hover",
    "statusIcon": "shrink-0 text-[length:var(--icon-md)]",
    "hint": "font-body text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "error": "font-body text-ctl-sm text-[color:var(--fields-error-ink-rest,var(--ink-invalid))]"
  },
  "kind": {
    "root": "none",
    "label": "none",
    "required": "none",
    "group": "none",
    "cell": "field",
    "statusIcon": "none",
    "hint": "none",
    "error": "none"
  },
  "internal": {
    "state": "error when an error shows, valid when valid holds, from error and valid"
  },
  "variants": {
    "state": {
      "neutral": {
        "cell": "focus:border-edge-focus focus:ring-[length:var(--bw-focus)] focus:ring-edge-focus/(--level-accent-soft-gold) disabled:border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))] hover:border-[color:var(--fields-neutral-field-edge-hover,var(--fields-neutral-field-edge-rest,var(--edge-field)))] border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] disabled:bg-[color:var(--fields-neutral-field-fill-disabled,var(--fields-neutral-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-neutral-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-neutral-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-neutral-field-ink-disabled,var(--fields-neutral-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-neutral-field-ink-hover,var(--fields-neutral-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-neutral-field-ink-rest,var(--ink-body))] disabled:opacity-[var(--fields-neutral-field-fade-disabled,var(--fade-disabled))]"
      },
      "error": {
        "cell": "ring-[length:var(--focus-width)] disabled:border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))] hover:border-[color:var(--fields-error-field-edge-hover,var(--fields-error-field-edge-rest,var(--edge-invalid)))] border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] disabled:bg-[color:var(--fields-error-field-fill-disabled,var(--fields-error-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-error-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-error-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-error-field-ink-disabled,var(--fields-error-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-error-field-ink-hover,var(--fields-error-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-error-field-ink-rest,var(--ink-body))] ring-[color:color-mix(in_oklab,var(--fields-error-field-edge-rest,var(--edge-invalid))_var(--level-hue-soft-danger),transparent)] disabled:opacity-[var(--fields-error-field-fade-disabled,var(--fade-disabled))]",
        "statusIcon": "text-[color:var(--fields-error-status-ink-rest,var(--ink-invalid))]"
      },
      "valid": {
        "cell": "ring-[length:var(--focus-width)] focus:border-edge-focus focus:ring-[length:var(--bw-focus)] focus:ring-edge-focus/(--level-accent-soft-gold) disabled:border-[color:var(--fields-valid-field-edge-disabled,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] hover:border-[color:var(--fields-valid-field-edge-hover,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] border-[color:var(--fields-valid-field-edge-rest,var(--hue-success-edge))] disabled:bg-[color:var(--fields-valid-field-fill-disabled,var(--fields-valid-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-valid-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-valid-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-valid-field-ink-disabled,var(--fields-valid-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-valid-field-ink-hover,var(--fields-valid-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-valid-field-ink-rest,var(--ink-body))] ring-[color:color-mix(in_oklab,var(--fields-valid-field-edge-rest,var(--hue-success-edge))_var(--level-hue-soft-success),transparent)] disabled:opacity-[var(--fields-valid-field-fade-disabled,var(--fade-disabled))]",
        "statusIcon": "text-[color:var(--fields-valid-status-ink-rest,var(--hue-success-ink))]"
      }
    },
    "disabled": {
      "true": {
        "label": "opacity-[var(--fade-disabled)]",
        "hint": "opacity-[var(--fade-disabled)]",
        "error": "opacity-[var(--fade-disabled)]",
        "statusIcon": "opacity-[var(--fade-disabled)]"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "state": "neutral",
    "disabled": false
  }
}
