{
  "component": "ArenaSelect",
  "slots": {
    "root": "flex flex-col gap-1.5",
    "label": "font-face-label text-ctl-xs tracking-label-role case-label text-ink-muted/(--level-ink-muted)",
    "wrap": "relative",
    "field": "appearance-none w-full h-ctl-h pl-3 pr-9 border-[length:var(--bw-field)] rounded-field font-body text-ctl cursor-pointer transition-[border-color,box-shadow] duration-[var(--dur-hover)] ease-hover focus:outline-none",
    "caret": "absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-ink-muted/(--level-ink-muted) text-[length:var(--icon-sm)]",
    "hint": "font-body text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "error": "font-body text-ctl-sm text-[color:var(--fields-error-ink-rest,var(--ink-invalid))]",
    "iconWrap": "absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none inline-flex text-ink-muted/(--level-ink-muted) text-[length:var(--icon-md)]"
  },
  "kind": {
    "root": "none",
    "label": "none",
    "wrap": "none",
    "field": "field",
    "caret": "none",
    "hint": "none",
    "error": "none",
    "iconWrap": "none"
  },
  "internal": {
    "state": "error when error is given, valid when valid holds",
    "hasIcon": "an icon is given"
  },
  "variants": {
    "state": {
      "neutral": {
        "field": "focus:border-edge-focus focus:ring-[length:var(--bw-focus)] focus:ring-edge-focus/(--level-accent-soft-gold) disabled:border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))] hover:border-[color:var(--fields-neutral-field-edge-hover,var(--fields-neutral-field-edge-rest,var(--edge-field)))] border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] disabled:bg-[color:var(--fields-neutral-field-fill-disabled,var(--fields-neutral-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-neutral-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-neutral-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-neutral-field-ink-disabled,var(--fields-neutral-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-neutral-field-ink-hover,var(--fields-neutral-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-neutral-field-ink-rest,var(--ink-body))] disabled:opacity-[var(--fields-neutral-field-fade-disabled,var(--fade-disabled))]"
      },
      "error": {
        "field": "ring-[length:var(--focus-width)] disabled:border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))] hover:border-[color:var(--fields-error-field-edge-hover,var(--fields-error-field-edge-rest,var(--edge-invalid)))] border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] disabled:bg-[color:var(--fields-error-field-fill-disabled,var(--fields-error-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-error-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-error-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-error-field-ink-disabled,var(--fields-error-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-error-field-ink-hover,var(--fields-error-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-error-field-ink-rest,var(--ink-body))] ring-[color:color-mix(in_oklab,var(--fields-error-field-edge-rest,var(--edge-invalid))_var(--level-hue-soft-danger),transparent)] disabled:opacity-[var(--fields-error-field-fade-disabled,var(--fade-disabled))]"
      },
      "valid": {
        "field": "ring-[length:var(--focus-width)] focus:border-edge-focus focus:ring-[length:var(--bw-focus)] focus:ring-edge-focus/(--level-accent-soft-gold) disabled:border-[color:var(--fields-valid-field-edge-disabled,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] hover:border-[color:var(--fields-valid-field-edge-hover,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] border-[color:var(--fields-valid-field-edge-rest,var(--hue-success-edge))] disabled:bg-[color:var(--fields-valid-field-fill-disabled,var(--fields-valid-field-fill-rest,var(--fill-field)))] hover:bg-[color:var(--fields-valid-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-valid-field-fill-rest,var(--fill-field))] disabled:text-[color:var(--fields-valid-field-ink-disabled,var(--fields-valid-field-ink-rest,var(--ink-body)))] hover:text-[color:var(--fields-valid-field-ink-hover,var(--fields-valid-field-ink-rest,var(--ink-body)))] text-[color:var(--fields-valid-field-ink-rest,var(--ink-body))] ring-[color:color-mix(in_oklab,var(--fields-valid-field-edge-rest,var(--hue-success-edge))_var(--level-hue-soft-success),transparent)] disabled:opacity-[var(--fields-valid-field-fade-disabled,var(--fade-disabled))]"
      }
    },
    "disabled": {
      "true": {
        "label": "opacity-[var(--fade-disabled)]",
        "hint": "opacity-[var(--fade-disabled)]",
        "error": "opacity-[var(--fade-disabled)]",
        "caret": "opacity-[var(--fade-disabled)]",
        "iconWrap": "opacity-[var(--fade-disabled)]"
      },
      "false": {}
    },
    "hasIcon": {
      "true": {
        "field": "pl-9"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "state": "neutral",
    "disabled": false,
    "hasIcon": false
  }
}
