{
  "component": "ArenaIconButton",
  "slots": {
    "root": "inline-flex items-center justify-center rounded-control cursor-pointer transition-[background] duration-[var(--dur-hover)] ease-hover disabled:opacity-45 disabled:cursor-not-allowed shadow-control-rest",
    "label": "font-body font-control text-ctl leading-ctl"
  },
  "variants": {
    "variant": {
      "ghost": {
        "root": "bg-transparent text-ink-body/(--level-ink-body) border-[length:var(--bw-control)] border-edge-control-quiet hover:bg-base-200"
      },
      "solid": {
        "root": "bg-primary text-primary-content border-none hover:bg-primary"
      }
    },
    "size": {
      "sm": {
        "root": "h-ctl-h-sm min-w-ctl-h-sm"
      },
      "md": {
        "root": "h-ctl-h min-w-ctl-h"
      },
      "lg": {
        "root": "h-ctl-h-lg min-w-ctl-h-lg"
      }
    },
    "showLabel": {
      "true": {
        "root": "w-auto gap-control pl-3 pr-3.5"
      },
      "false": {
        "root": "p-0 gap-0"
      }
    },
    "pressed": {
      "true": {
        "root": "bg-primary/14 text-ink-body/(--level-ink-body) border-primary/38 hover:bg-primary/22"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "variant": "ghost",
    "size": "md",
    "showLabel": false
  }
}
