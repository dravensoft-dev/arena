{
  "component": "ArenaRadio",
  "slots": {
    "group": "flex flex-col gap-items",
    "root": "relative inline-flex items-start min-h-ctl-h-sm gap-2.5 w-fit",
    "ring": "inline-flex items-center justify-center size-5 shrink-0 rounded-pill border-[length:var(--bw-control)] transition-[border-color] duration-[var(--dur-hover)] ease-hover [&:has(~input:focus-visible)]:shadow-[0_0_0_var(--bw-focus)_var(--edge-focus)] shadow-control-rest border-[color:var(--choices-box-edge-rest,var(--edge-control))] bg-[color:var(--choices-box-fill-rest,var(--fill-control))]",
    "dot": "size-2.5 rounded-pill bg-current text-[color:var(--choices-mark-ink-selected,var(--emphasis-primary-ink))]",
    "text": "flex flex-col gap-0.5",
    "label": "font-body text-ctl text-ink-body/(--level-ink-body) leading-snug",
    "hint": "font-body text-ctl-sm text-ink-muted/(--level-ink-muted) leading-prose",
    "input": "absolute opacity-0 size-0"
  },
  "kind": {
    "group": "none",
    "root": "none",
    "ring": "none",
    "dot": "none",
    "text": "none",
    "label": "none",
    "hint": "none",
    "input": "none"
  },
  "internal": {
    "checked": "the group's value is this radio's value"
  },
  "variants": {
    "checked": {
      "true": {
        "ring": "border-[color:var(--choices-box-edge-selected,transparent)] bg-[color:var(--choices-box-fill-selected,var(--fill-control-on))]"
      },
      "false": {}
    },
    "disabled": {
      "true": {
        "root": "cursor-not-allowed",
        "ring": "border-[color:var(--choices-box-edge-disabled,var(--choices-box-edge-rest,var(--edge-control)))] bg-[color:var(--choices-box-fill-disabled,var(--choices-box-fill-rest,var(--fill-control)))] opacity-[var(--choices-box-fade-disabled,var(--fade-disabled))]",
        "dot": "text-[color:var(--choices-mark-ink-selected-disabled,var(--choices-mark-ink-selected,var(--emphasis-primary-ink)))]",
        "text": "opacity-[var(--fade-disabled)]"
      },
      "false": {
        "root": "cursor-pointer"
      }
    }
  },
  "compoundVariants": [
    {
      "checked": true,
      "disabled": true,
      "class": {
        "ring": "border-[color:var(--choices-box-edge-selected-disabled,var(--choices-box-edge-selected,transparent))] bg-[color:var(--choices-box-fill-selected-disabled,var(--choices-box-fill-selected,var(--fill-control-on)))] opacity-[var(--choices-box-fade-selected-disabled,var(--fade-disabled))]"
      }
    }
  ],
  "defaultVariants": {
    "checked": false,
    "disabled": false
  }
}
