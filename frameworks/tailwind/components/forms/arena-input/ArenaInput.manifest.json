{
  "component": "ArenaInput",
  "slots": {
    "root": "flex flex-col gap-1.5",
    "label": "font-face-label text-ctl-xs tracking-label-role case-label text-[color:color-mix(in_oklab,var(--text-muted-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
    "required": "ml-1 text-[color:var(--fields-required-ink-rest,var(--accent-primary-ink))]",
    "field": "flex items-center gap-control h-ctl-h px-control-x border-[length:var(--bw-field)] rounded-field transition-[border-color,box-shadow] duration-[var(--dur-hover)] ease-hover",
    "icon": "inline-flex text-[color:color-mix(in_oklab,var(--text-muted-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)] text-[length:var(--icon-md)]",
    "prefix": "font-mono text-ctl-md text-[color:color-mix(in_oklab,var(--text-muted-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
    "input": "flex-1 min-w-0 border-none focus:outline-hidden font-body text-ctl [&::-webkit-calendar-picker-indicator]:cursor-pointer [&::-webkit-calendar-picker-indicator]:opacity-60 [&::-webkit-calendar-picker-indicator]:[filter:invert(var(--picker-invert))] [&::-webkit-calendar-picker-indicator]:transition-opacity [&::-webkit-calendar-picker-indicator]:duration-[var(--dur-hover)] hover:[&::-webkit-calendar-picker-indicator]:opacity-100 bg-[color:var(--fields-value-fill-rest,transparent)] text-[color:var(--fields-value-ink-rest,var(--ink-body))] placeholder:text-[color:color-mix(in_oklab,var(--fields-value-ink-rest,var(--ink-body))_var(--level-ink-muted),transparent)]",
    "statusIcon": "text-[length:var(--icon-md)]",
    "hint": "font-body text-ctl-sm text-[color:color-mix(in_oklab,var(--text-muted-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
    "error": "font-body text-ctl-sm text-[color:var(--fields-error-ink-rest,var(--ink-invalid))]"
  },
  "kind": {
    "root": "none",
    "label": "none",
    "required": "none",
    "field": "field",
    "icon": "none",
    "prefix": "none",
    "input": "none",
    "statusIcon": "none",
    "hint": "none",
    "error": "none"
  },
  "internal": {
    "state": "error when an error shows, valid when valid holds, from error, validate, touched and valid"
  },
  "variants": {
    "state": {
      "neutral": {
        "field": "focus-within:border-edge-focus focus-within:outline-hidden focus-within:ring-[length:var(--bw-focus)] focus-within:ring-edge-focus/(--level-accent-soft-gold) hover:border-[color:var(--fields-neutral-field-edge-hover,var(--fields-neutral-field-edge-rest,var(--edge-field)))] border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] hover:bg-[color:var(--fields-neutral-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-neutral-field-fill-rest,var(--fill-field))] hover:focus-within:border-edge-focus"
      },
      "error": {
        "field": "ring-[length:var(--focus-width)] hover:border-[color:var(--fields-error-field-edge-hover,var(--fields-error-field-edge-rest,var(--edge-invalid)))] border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] hover:bg-[color:var(--fields-error-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-error-field-fill-rest,var(--fill-field))] ring-[color:color-mix(in_oklab,var(--fields-error-field-edge-rest,var(--edge-invalid))_var(--level-hue-soft-danger),transparent)]",
        "statusIcon": "text-[color:var(--fields-error-status-ink-rest,var(--ink-invalid))]"
      },
      "valid": {
        "field": "ring-[length:var(--focus-width)] focus-within:border-edge-focus focus-within:outline-hidden focus-within:ring-[length:var(--bw-focus)] focus-within:ring-edge-focus/(--level-accent-soft-gold) hover:border-[color:var(--fields-valid-field-edge-hover,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] border-[color:var(--fields-valid-field-edge-rest,var(--hue-success-edge))] hover:bg-[color:var(--fields-valid-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-valid-field-fill-rest,var(--fill-field))] ring-[color:color-mix(in_oklab,var(--fields-valid-field-edge-rest,var(--hue-success-edge))_var(--level-hue-soft-success),transparent)] hover:focus-within:border-edge-focus",
        "statusIcon": "text-[color:var(--fields-valid-status-ink-rest,var(--hue-success-ink))]"
      }
    },
    "disabled": {
      "true": {
        "label": "opacity-[var(--fade-disabled)]",
        "hint": "opacity-[var(--fade-disabled)]",
        "error": "opacity-[var(--fade-disabled)]"
      },
      "false": {}
    },
    "readOnly": {
      "true": {
        "field": "bg-[color:var(--fields-readonly-field-fill-rest,var(--fill-surface))] hover:bg-[color:var(--fields-readonly-field-fill-rest,var(--fill-surface))]",
        "input": "cursor-default"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "state": "neutral",
    "disabled": false,
    "readOnly": false
  },
  "compoundVariants": [
    {
      "readOnly": true,
      "state": "neutral",
      "class": {
        "field": "hover:border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))]"
      }
    },
    {
      "readOnly": true,
      "state": "error",
      "class": {
        "field": "hover:border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))]"
      }
    },
    {
      "readOnly": true,
      "state": "valid",
      "class": {
        "field": "hover:border-[color:var(--fields-valid-field-edge-rest,var(--hue-success-edge))]"
      }
    },
    {
      "state": "error",
      "disabled": true,
      "class": {
        "field": "border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))] bg-[color:var(--fields-error-field-fill-disabled,var(--fields-error-field-fill-rest,var(--fill-field)))] opacity-[var(--fields-error-field-fade-disabled,var(--fade-disabled))] hover:border-[color:var(--fields-error-field-edge-disabled,var(--fields-error-field-edge-rest,var(--edge-invalid)))] hover:bg-[color:var(--fields-error-field-fill-disabled,var(--fields-error-field-fill-rest,var(--fill-field)))]"
      }
    },
    {
      "state": "neutral",
      "disabled": true,
      "class": {
        "field": "border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))] bg-[color:var(--fields-neutral-field-fill-disabled,var(--fields-neutral-field-fill-rest,var(--fill-field)))] opacity-[var(--fields-neutral-field-fade-disabled,var(--fade-disabled))] hover:border-[color:var(--fields-neutral-field-edge-disabled,var(--fields-neutral-field-edge-rest,var(--edge-field)))] hover:bg-[color:var(--fields-neutral-field-fill-disabled,var(--fields-neutral-field-fill-rest,var(--fill-field)))]"
      }
    },
    {
      "state": "valid",
      "disabled": true,
      "class": {
        "field": "border-[color:var(--fields-valid-field-edge-disabled,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] bg-[color:var(--fields-valid-field-fill-disabled,var(--fields-valid-field-fill-rest,var(--fill-field)))] opacity-[var(--fields-valid-field-fade-disabled,var(--fade-disabled))] hover:border-[color:var(--fields-valid-field-edge-disabled,var(--fields-valid-field-edge-rest,var(--hue-success-edge)))] hover:bg-[color:var(--fields-valid-field-fill-disabled,var(--fields-valid-field-fill-rest,var(--fill-field)))]"
      }
    },
    {
      "readOnly": true,
      "disabled": true,
      "class": {
        "field": "bg-[color:var(--fields-readonly-field-fill-disabled,var(--fields-readonly-field-fill-rest,var(--fill-surface)))] opacity-[var(--fields-readonly-field-fade-disabled,var(--fade-disabled))] hover:bg-[color:var(--fields-readonly-field-fill-disabled,var(--fields-readonly-field-fill-rest,var(--fill-surface)))]"
      }
    }
  ]
}
