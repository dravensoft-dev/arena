      },
      "gold": {
        "root": "bg-secondary/16 text-ink-body/(--level-ink-body)"
      },
      "success": {
        "root": "bg-[color:var(--arena-hue-fill-soft)] text-ink-body/(--level-ink-body)"
      },
      "warning": {
        "root": "bg-[color:var(--arena-hue-fill-soft)] text-ink-body/(--level-ink-body)"
      },
      "danger": {
        "root": "bg-[color:var(--arena-hue-fill-soft)] text-ink-body/(--level-ink-body)"
      },
      "info": {
        "root": "bg-[color:var(--arena-hue-fill-soft)] text-ink-body/(--level-ink-body)"
      }
    }
  },
  "defaultVariants": {
    "tone": "neutral"
  },
  "hues": {
    "tone": {
      "neutral": null,
      "accent": null,
      "gold": null,
      "success": "success",
      "warning": "warning",
      "danger": "danger",
      "info": "info"
    }
