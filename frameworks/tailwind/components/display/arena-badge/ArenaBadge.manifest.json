{
  "component": "ArenaBadge",
  "answers": [
    {
      "family": "accent",
      "options": [
        "arena-accent-plain",
        "arena-accent-primary",
        "arena-accent-gold"
      ],
      "default": "arena-accent-plain"
    }
  ],
  "slots": {
    "root": "inline-flex items-center gap-marker px-2.5 py-marker-y rounded-marker font-face-label text-ctl-xs font-bold tracking-label-role case-label w-fit bg-[color:var(--arena-accent-fill-soft,var(--accent-plain-fill-soft))] text-ink-body/(--level-ink-body)",
    "dot": "size-1.5 rounded-pill bg-current"
  },
  "kind": {
    "root": "marker",
    "dot": "none"
  },
  "variants": {
    "tone": {
      "neutral": {},
      "success": {
        "root": "bg-[color:var(--arena-hue-fill-soft)]"
      },
      "warning": {
        "root": "bg-[color:var(--arena-hue-fill-soft)]"
      },
      "danger": {
        "root": "bg-[color:var(--arena-hue-fill-soft)]"
      },
      "info": {
        "root": "bg-[color:var(--arena-hue-fill-soft)]"
      }
    }
  },
  "defaultVariants": {
    "tone": "neutral"
  },
  "hues": {
    "tone": {
      "neutral": null,
      "success": "success",
      "warning": "warning",
      "danger": "danger",
      "info": "info"
    }
  }
}
