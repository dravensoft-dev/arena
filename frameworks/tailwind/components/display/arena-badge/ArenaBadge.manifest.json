{
  "component": "ArenaBadge",
  "slots": {
    "root": "inline-flex items-center gap-marker px-2.5 py-marker-y rounded-marker font-face-label text-ctl-xs font-bold tracking-label-role case-label w-fit",
    "dot": "size-1.5 rounded-pill bg-current"
  },
  "kind": {
