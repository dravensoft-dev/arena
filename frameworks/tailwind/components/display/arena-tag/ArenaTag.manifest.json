{
  "component": "ArenaTag",
  "slots": {
    "root": "inline-flex items-center gap-marker rounded-marker border-[length:var(--bw-marker)] px-2 py-0.5 text-ctl-xs font-semibold w-fit",
    "dot": "size-1.5 rounded-pill bg-current",
    "close": "inline-flex items-center bg-transparent border-none cursor-pointer p-0 text-ink-muted/(--level-ink-muted) text-[length:var(--icon-sm)] leading-ctl"
  },
  "kind": {
    "root": "marker",
    "dot": "none",
    "close": "none"
  },
  "variants": {
    "tone": {
      "neutral": {
        "root": "border-edge-surface text-ink-body/(--level-ink-quiet)"
      },
      "primary": {
        "root": "border-primary text-primary"
      },
      "success": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "warning": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "danger": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "identity": {
        "root": "border-[color:var(--arena-tag-cat)] text-[color:var(--arena-tag-cat)]"
      }
    },
    "colorId": {
      "1": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "2": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "3": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "4": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "5": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "6": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "7": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      },
      "8": {
        "root": "border-[color:var(--arena-hue-edge)] text-[color:var(--arena-hue-ink)]"
      }
    },
    "disabled": {
      "true": {
        "close": "cursor-not-allowed text-ink-muted/40"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "tone": "neutral",
    "disabled": false
  },
  "hues": {
    "tone": {
      "neutral": null,
      "primary": null,
      "success": "success",
      "warning": "warning",
      "danger": "danger",
      "identity": null
    },
    "colorId": {
      "1": "identity-1",
      "2": "identity-2",
      "3": "identity-3",
      "4": "identity-4",
      "5": "identity-5",
      "6": "identity-6",
      "7": "identity-7",
      "8": "identity-8"
    }
  }
}
