{
  "component": "ArenaAvatar",
  "answers": [
    {
      "family": "size",
      "options": [
        "arena-size-xs",
        "arena-size-sm",
        "arena-size-md",
        "arena-size-lg"
      ],
      "default": "arena-size-md"
    }
  ],
  "slots": {
    "root": "relative inline-flex shrink-0 size-[var(--arena-size-avatar,var(--size-md-avatar))]",
    "box": "inline-flex items-center justify-center overflow-hidden bg-base-300 border-[length:var(--bw-marker)] border-edge-marker font-display font-extrabold tracking-normal text-ink-body/(--level-ink-body) size-[var(--arena-size-avatar,var(--size-md-avatar))] text-[length:calc(var(--arena-size-avatar,var(--size-md-avatar))*0.4)]",
    "image": "w-full h-full object-cover",
    "status": "absolute right-0 bottom-0 rounded-pill border-[length:var(--bw-strong)] border-base-200 size-[max(calc(var(--sp-1)*2),calc(var(--arena-size-avatar,var(--size-md-avatar))*0.28))]"
  },
  "kind": {
    "root": "none",
    "box": "none",
    "image": "none",
    "status": "none"
  },
  "variants": {
    "kind": {
      "person": {
        "box": "rounded-pill"
      },
      "team": {
        "box": "rounded-md"
      }
    },
    "status": {
      "none": {},
      "online": {
        "status": "bg-[color:var(--arena-hue-fill-strong)]"
      },
      "busy": {
        "status": "bg-[color:var(--arena-hue-ink)]"
      },
      "away": {
        "status": "bg-[color:var(--arena-hue-fill-strong)]"
      },
      "offline": {
        "status": "bg-base-content/(--level-presence)"
      }
    }
  },
  "defaultVariants": {
    "kind": "person",
    "status": "none"
  },
  "hues": {
    "status": {
      "none": null,
      "online": "success",
      "busy": "danger",
      "away": "warning",
      "offline": null
    }
  }
}
