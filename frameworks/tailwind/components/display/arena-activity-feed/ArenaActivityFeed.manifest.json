{
  "component": "ArenaActivityFeed",
  "slots": {
    "root": "flex flex-col list-none m-0 p-0",
    "item": "flex items-center gap-items py-3.5",
    "dot": "flex-none size-2 rounded-pill bg-current",
    "text": "font-body text-ctl text-ink-body/(--level-ink-body)",
    "actor": "font-bold text-ink-body",
    "target": "font-mono text-ctl-md text-secondary",
    "time": "ml-auto font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)"
  },
  "variants": {
    "tone": {
      "neutral": { "dot": "text-ink-body/(--level-ink-body)" },
      "accent": { "dot": "text-primary" },
      "gold": { "dot": "text-secondary" },
      "success": { "dot": "text-success" },
      "warning": { "dot": "text-warning" },
      "danger": { "dot": "text-error" },
      "info": { "dot": "text-info" }
    },
    "divided": {
      "true": { "item": "border-t-[length:var(--bw-separator)] border-edge-separator" },
      "false": { "item": "border-t-0" }
    }
  },
  "defaultVariants": { "tone": "accent", "divided": true }
}
