{
  "component": "ArenaActivityFeed",
  "answers": [
    {
      "family": "accent",
      "options": [
        "arena-accent-primary",
        "arena-accent-gold"
      ],
      "default": "arena-accent-primary"
    }
  ],
  "slots": {
    "root": "flex flex-col list-none m-0 p-0",
    "item": "flex items-center gap-row py-[calc(var(--sp-1)*3.5*var(--dz-row-scale-y))]",
    "dot": "flex-none size-2 rounded-pill bg-current text-[color:var(--arena-accent-marks-dot-ink)]",
    "text": "font-body text-ctl text-ink-body/(--level-ink-body)",
    "actor": "font-bold text-ink-body",
    "target": "font-mono text-ctl-md text-ink-figure/(--level-ink-full)",
    "time": "ml-auto font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)"
  },
  "kind": {
    "root": "none",
    "item": "row",
    "dot": "none",
    "text": "none",
    "actor": "none",
    "target": "none",
    "time": "none"
  },
  "internal": {
    "divided": "every row after the first draws the separator (index > 0)"
  },
  "variants": {
    "tone": {
      "neutral": {
        "dot": "text-[color:color-mix(in_oklab,var(--marks-neutral-dot-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)]"
      },
      "success": {
        "dot": "text-[color:var(--marks-success-dot-ink-rest,var(--hue-success-ink))]"
      },
      "warning": {
        "dot": "text-[color:var(--marks-warning-dot-ink-rest,var(--hue-warning-ink))]"
      },
      "danger": {
        "dot": "text-[color:var(--marks-danger-dot-ink-rest,var(--hue-danger-ink))]"
      },
      "info": {
        "dot": "text-[color:var(--marks-info-dot-ink-rest,var(--hue-info-ink))]"
      }
    },
    "divided": {
      "true": {
        "item": "border-t-[length:var(--bw-separator)] border-[color:var(--surfaces-separator-edge-rest,var(--edge-separator))]"
      },
      "false": {
        "item": "border-t-0"
      }
    }
  },
  "defaultVariants": {
    "divided": true
  }
}
