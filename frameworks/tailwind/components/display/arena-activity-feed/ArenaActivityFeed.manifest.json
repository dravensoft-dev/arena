{
  "component": "ArenaActivityFeed",
  "slots": {
    "root": "flex flex-col list-none m-0 p-0",
    "item": "flex items-center gap-row py-[calc(var(--sp-1)*3.5*var(--dz-row-scale-y))]",
    "dot": "flex-none size-2 rounded-pill bg-current",
    "text": "font-body text-ctl text-ink-body/(--level-ink-body)",
    "actor": "font-bold text-ink-body",
    "target": "font-mono text-ctl-md text-secondary",
    "time": "ml-auto font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)"
  },
  "kind": {
    "root": "none",
    "item": "row",
    "dot": "none",
    "text": "none",
    "actor": "none",
    "target": "none",
    "time": "none"
  },
  "internal": {
    "divided": "every row after the first draws the separator (index > 0)"
  },
  "variants": {
    "tone": {
      "neutral": {
        "dot": "text-ink-body/(--level-ink-body)"
      },
      "accent": {
        "dot": "text-primary"
      },
      "gold": {
        "dot": "text-secondary"
      },
      "success": {
        "dot": "text-[color:var(--arena-hue-fill-strong)]"
      },
      "warning": {
        "dot": "text-[color:var(--arena-hue-fill-strong)]"
      },
      "danger": {
        "dot": "text-[color:var(--arena-hue-ink)]"
      },
      "info": {
        "dot": "text-[color:var(--arena-hue-fill-strong)]"
      }
    },
    "divided": {
      "true": {
        "item": "border-t-[length:var(--bw-separator)] border-edge-separator"
      },
      "false": {
        "item": "border-t-0"
      }
    }
  },
  "defaultVariants": {
    "tone": "accent",
    "divided": true
  },
  "hues": {
    "tone": {
      "neutral": null,
      "accent": null,
      "gold": null,
      "success": "success",
      "warning": "warning",
      "danger": "danger",
      "info": "info"
    }
  }
}
