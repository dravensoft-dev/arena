    "legendSwatch": "size-2.5 rounded-marker shrink-0",
    "legendText": "flex flex-1 min-w-0",
    "legendLabel": "flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap font-body text-ctl-sm text-ink-body/(--level-ink-body)",
    "legendValue": "font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)"
  },
  "kind": {
    "legend": "none",
    "legendRow": "marker",
    "legendSwatch": "none",
    "legendText": "none",
    "legendLabel": "none",
    "legendValue": "none"
  },
