{
  "component": "ArenaMeter",
  "answers": [
    {
      "family": "size",
      "options": [
        "arena-size-sm",
        "arena-size-md",
        "arena-size-lg"
      ],
      "default": "arena-size-md"
    },
    {
      "family": "accent",
      "options": [
        "arena-accent-primary",
        "arena-accent-gold"
      ],
      "default": "arena-accent-primary"
    }
  ],
  "slots": {
    "root": "grid w-full",
    "head": "flex items-baseline gap-items mb-2",
    "label": "flex-1 min-w-0 font-body text-ctl-md text-ink-body/(--level-ink-body)",
    "value": "font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "standing": "font-face-label text-ctl-xs tracking-label-role case-label text-[color:color-mix(in_oklab,var(--meters-neutral-standing-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
    "track": "relative rounded-pill overflow-hidden h-[var(--arena-size-meter,var(--size-md-meter))] bg-[color:var(--arena-accent-meters-track-fill)] text-[color:var(--arena-accent-meters-track-ink)]",
    "fill": "absolute inset-0 bg-current rounded-[inherit]"
  },
  "kind": {
    "root": "none",
    "head": "none",
    "label": "none",
    "value": "none",
    "standing": "none",
    "track": "none",
    "fill": "none"
  },
  "variants": {
    "standing": {
      "optimum": {
        "standing": "text-[color:var(--meters-success-standing-ink-rest,var(--hue-success-ink))]",
        "track": "bg-[color:var(--meters-success-track-fill-rest,var(--fill-track))] text-[color:var(--meters-success-track-ink-rest,var(--hue-success-ink))]"
      },
      "fair": {
        "standing": "text-[color:var(--meters-warning-standing-ink-rest,var(--hue-warning-ink))]",
        "track": "bg-[color:var(--meters-warning-track-fill-rest,var(--fill-track))] text-[color:var(--meters-warning-track-ink-rest,var(--hue-warning-ink))]"
      },
      "poor": {
        "standing": "text-[color:var(--meters-danger-standing-ink-rest,var(--hue-danger-ink))]",
        "track": "bg-[color:var(--meters-danger-track-fill-rest,var(--fill-track))] text-[color:var(--meters-danger-track-ink-rest,var(--hue-danger-ink))]"
      },
      "none": {}
    }
  },
  "defaultVariants": {
    "standing": "none"
  },
  "internal": {
    "standing": "derived from low, high and optimum by the component: the region holding the value against the region holding the optimum"
  }
}
