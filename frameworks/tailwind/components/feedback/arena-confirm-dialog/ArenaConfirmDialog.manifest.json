{
  "component": "ArenaConfirmDialog",
  "slots": {
    "root": "fixed inset-0 z-modal-nested flex items-center justify-center bg-scrim backdrop-blur-scrim",
    "panel": "w-[var(--confirm-dialog-width)] max-w-[92vw] bg-surface-floating border-[length:var(--bw-surface)] border-edge-surface-floating rounded-surface shadow-surface-deep overflow-hidden",
    "head": "px-floating-x pt-5.5",
    "eyebrow": "font-face-eyebrow text-eyebrow tracking-eyebrow case-eyebrow mb-2 font-eyebrow",
    "title": "font-face-heading font-heading text-title-section text-ink-heading tracking-heading leading-heading",
    "body": "px-floating-x py-floating-y font-body text-md leading-prose text-ink-body/(--level-ink-body)",
    "requireBlock": "mt-3.5",
    "requireLabel": "font-face-label text-ctl-xs tracking-label-role case-label text-ink-muted/(--level-ink-muted) mb-1.5",
    "input": "w-full h-ctl-h px-control-x border-[length:var(--bw-field)] rounded-field font-mono text-ctl outline-none focus-visible:ring-[length:var(--bw-focus)] focus-visible:ring-edge-focus text-[color:var(--fields-value-ink-rest,var(--ink-body))]",
    "foot": "flex flex-wrap justify-end gap-actions px-floating-x pb-5.5",
    "confirm": "inline-flex items-center justify-center h-ctl-h px-4.5 rounded-control border-[length:var(--bw-control)] font-body font-control text-ctl cursor-pointer disabled:cursor-not-allowed gap-control transition-[background,box-shadow] duration-[var(--dur-hover)] ease-hover hover:shadow-control-raised shadow-control-rest focus-visible:outline-[length:var(--bw-focus)] focus-visible:outline-edge-focus focus-visible:outline-offset-[var(--gap-focus)]"
  },
  "kind": {
    "root": "none",
    "panel": "floating",
    "head": "floating",
    "eyebrow": "none",
    "title": "none",
    "body": "floating",
    "requireBlock": "none",
    "requireLabel": "none",
    "input": "field",
    "foot": "floating",
    "confirm": "control"
  },
  "floating": {
    "root": "a modal surface lays itself over the page, so the region it was opened from does not decide its controls"
  },
  "internal": {
    "invalid": "the typed confirmation text does not match yet"
  },
