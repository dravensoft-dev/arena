mphasis-primary-ink))))] disabled:text-[color:var(--actions-primary-root-ink-disabled,var(--actions-primary-root-ink-rest,var(--emphasis-primary-ink)))] disabled:opacity-[var(--actions-primary-root-fade-disabled,var(--fade-disabled))]"
      }
    },
    "invalid": {
      "true": {
        "input": "hover:border-[color:var(--fields-error-field-edge-hover,var(--fields-error-field-edge-rest,var(--edge-invalid)))] border-[color:var(--fields-error-field-edge-rest,var(--edge-invalid))] hover:bg-[color:var(--fields-error-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-error-field-fill-rest,var(--fill-field))]"
      },
      "false": {
        "input": "hover:border-[color:var(--fields-neutral-field-edge-hover,var(--fields-neutral-field-edge-rest,var(--edge-field)))] border-[color:var(--fields-neutral-field-edge-rest,var(--edge-field))] hover:bg-[color:var(--fields-neutral-field-fill-hover,var(--fill-hover))] bg-[color:var(--fields-neutral-field-fill-rest,var(--fill-field))]"
      }
    },
    "open": {
      "true": {},
      "false": {
        "root": "hidden"
      }
    }
