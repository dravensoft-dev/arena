{
  "component": "ArenaProgressBar",
  "answers": [
    {
      "family": "size",
      "options": [
        "arena-size-sm",
        "arena-size-md",
        "arena-size-lg"
      ],
      "default": "arena-size-md"
    },
    {
      "family": "accent",
      "options": [
        "arena-accent-primary",
        "arena-accent-gold"
      ],
      "default": "arena-accent-primary"
    }
  ],
  "slots": {
    "root": "grid",
    "head": "flex items-baseline justify-between gap-items mb-2",
    "label": "font-body text-ctl-md text-[color:color-mix(in_oklab,var(--text-body-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)]",
    "value": "font-mono text-ctl-sm text-[color:color-mix(in_oklab,var(--text-muted-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
    "track": "relative rounded-pill overflow-hidden h-[var(--arena-size-meter,var(--size-md-meter))] bg-[color:var(--arena-accent-meters-track-fill)] text-[color:var(--arena-accent-meters-track-ink)]",
    "announcement": "sr-only",
    "fill": "absolute inset-0 bg-current rounded-[inherit] transition-[width] duration-[var(--dur-state)] ease-state",
    "ring": "relative grid place-items-center shrink-0 size-[var(--arena-size-ring,var(--size-md-ring))] text-[color:var(--arena-accent-meters-track-ink)]",
    "ringContent": "relative grid place-items-center [grid-area:1/1]",
    "ringGeometry": "absolute inset-0 size-full -rotate-90",
    "ringTrack": "fill-none [vector-effect:non-scaling-stroke] [stroke-width:var(--arena-size-meter,var(--size-md-meter))] stroke-[color:var(--arena-accent-meters-track-fill)]",
    "ringFill": "fill-none stroke-current [vector-effect:non-scaling-stroke] [stroke-dasharray:100] [stroke-linecap:round] transition-[stroke-dashoffset] duration-[var(--dur-state)] ease-state [stroke-width:var(--arena-size-meter,var(--size-md-meter))]"
  },
  "kind": {
    "root": "none",
    "head": "none",
    "label": "none",
    "value": "none",
    "track": "none",
    "announcement": "none",
    "fill": "none",
    "ring": "none",
    "ringContent": "none",
    "ringGeometry": "none",
    "ringTrack": "none",
    "ringFill": "none"
  },
  "variants": {
    "shape": {
      "linear": {
        "root": "w-full"
      },
      "radial": {
        "root": "w-fit justify-items-center gap-items",
        "label": "text-center",
        "value": "font-mono text-ctl-md text-[color:color-mix(in_oklab,var(--text-body-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)] [grid-area:1/1]"
      }
    },
    "tone": {
      "success": {
        "track": "bg-[color:var(--meters-success-track-fill-rest,var(--fill-track))] text-[color:var(--meters-success-track-ink-rest,var(--hue-success-ink))]",
        "ring": "text-[color:var(--meters-success-track-ink-rest,var(--hue-success-ink))]",
        "ringTrack": "stroke-[color:var(--meters-success-track-fill-rest,var(--fill-track))]"
      },
      "danger": {
        "track": "bg-[color:var(--meters-danger-track-fill-rest,var(--fill-track))] text-[color:var(--meters-danger-track-ink-rest,var(--hue-danger-ink))]",
        "ring": "text-[color:var(--meters-danger-track-ink-rest,var(--hue-danger-ink))]",
        "ringTrack": "stroke-[color:var(--meters-danger-track-fill-rest,var(--fill-track))]"
      },
      "info": {
        "track": "bg-[color:var(--meters-info-track-fill-rest,var(--fill-track))] text-[color:var(--meters-info-track-ink-rest,var(--hue-info-ink))]",
        "ring": "text-[color:var(--meters-info-track-ink-rest,var(--hue-info-ink))]",
        "ringTrack": "stroke-[color:var(--meters-info-track-fill-rest,var(--fill-track))]"
      }
    },
    "indeterminate": {
      "true": {
        "track": "arena-prog-indeterminate",
        "ringFill": "arena-prog-ring"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "shape": "linear",
    "indeterminate": false
  }
}
