{
  "component": "ArenaProgressBar",
  "answers": [
    {
      "family": "size",
      "options": [
        "arena-size-sm",
        "arena-size-md",
        "arena-size-lg"
      ],
      "default": "arena-size-md"
    }
  ],
  "slots": {
    "root": "grid",
    "head": "flex items-baseline justify-between gap-items mb-2",
    "label": "font-body text-ctl-md text-ink-body/(--level-ink-body)",
    "value": "font-mono text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "track": "relative rounded-pill bg-track overflow-hidden h-[var(--arena-size-meter,var(--size-md-meter))]",
    "announcement": "sr-only",
    "fill": "absolute inset-0 bg-current rounded-[inherit] transition-[width] duration-[var(--dur-state)] ease-state",
    "ring": "relative grid place-items-center shrink-0 size-[var(--arena-size-ring,var(--size-md-ring))]",
    "ringContent": "relative grid place-items-center [grid-area:1/1]",
    "ringGeometry": "absolute inset-0 size-full -rotate-90",
    "ringTrack": "fill-none stroke-base-300 [vector-effect:non-scaling-stroke] [stroke-width:var(--arena-size-meter,var(--size-md-meter))]",
    "ringFill": "fill-none stroke-current [vector-effect:non-scaling-stroke] [stroke-dasharray:100] [stroke-linecap:round] transition-[stroke-dashoffset] duration-[var(--dur-state)] ease-state [stroke-width:var(--arena-size-meter,var(--size-md-meter))]"
  },
  "kind": {
    "root": "none",
    "head": "none",
    "label": "none",
    "value": "none",
    "track": "none",
    "announcement": "none",
    "fill": "none",
    "ring": "none",
    "ringContent": "none",
    "ringGeometry": "none",
    "ringTrack": "none",
    "ringFill": "none"
  },
  "variants": {
    "shape": {
      "linear": {
        "root": "w-full"
      },
      "radial": {
        "root": "w-fit justify-items-center gap-items",
        "label": "text-center",
        "value": "font-mono text-ctl-md text-ink-body/(--level-ink-body) [grid-area:1/1]"
      }
    },
    "tone": {
      "accent": {
        "track": "text-primary",
        "ring": "text-primary"
      },
      "gold": {
        "track": "text-secondary",
        "ring": "text-secondary"
      },
      "success": {
        "track": "text-[color:var(--arena-hue-fill-strong)]",
        "ring": "text-[color:var(--arena-hue-fill-strong)]"
      },
      "danger": {
        "track": "text-[color:var(--arena-hue-ink)]",
        "ring": "text-[color:var(--arena-hue-ink)]"
      },
      "info": {
        "track": "text-[color:var(--arena-hue-fill-strong)]",
        "ring": "text-[color:var(--arena-hue-fill-strong)]"
      }
    },
    "indeterminate": {
      "true": {
        "track": "arena-prog-indeterminate",
        "ringFill": "arena-prog-ring"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "shape": "linear",
    "tone": "accent",
    "indeterminate": false
  },
  "hues": {
    "tone": {
      "accent": null,
      "gold": null,
      "success": "success",
      "danger": "danger",
      "info": "info"
    }
  }
}
