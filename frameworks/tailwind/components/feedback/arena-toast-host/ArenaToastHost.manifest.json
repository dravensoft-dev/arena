{
  "component": "ArenaToastHost",
  "slots": {
    "root": "fixed flex flex-col gap-items z-toast"
  },
  "kind": {
    "root": "none"
  },
  "floating": {
    "root": "a toast stack is pinned to the viewport, so the region that raised a toast does not decide its controls"
  },
  "variants": {
    "placement": {
      "top-start": {
        "root": "top-[max(var(--sp-6),var(--pad-safe-top))] start-6"
      },
      "top-end": {
        "root": "top-[max(var(--sp-6),var(--pad-safe-top))] end-6"
      },
      "bottom-start": {
        "root": "bottom-[max(var(--sp-6),var(--pad-safe-bottom))] start-6"
      },
      "bottom-end": {
        "root": "bottom-[max(var(--sp-6),var(--pad-safe-bottom))] end-6"
      }
    }
  },
  "defaultVariants": {
    "placement": "bottom-end"
  }
}
