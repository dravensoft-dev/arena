{
  "component": "ArenaSpinner",
  "answers": [
    {
      "family": "size",
      "options": [
        "arena-size-sm",
        "arena-size-md",
        "arena-size-lg"
      ],
      "default": "arena-size-md"
    }
  ],
  "slots": {
    "root": "inline-flex w-fit",
    "circle": "arena-spinner inline-block border-[length:var(--bw-strong)] border-current border-t-transparent rounded-pill size-[var(--arena-size-spinner,var(--size-md-spinner))]"
  },
  "kind": {
    "root": "none",
    "circle": "none"
  },
  "variants": {
    "tone": {
      "accent": {
        "root": "text-primary"
      },
      "gold": {
        "root": "text-secondary"
      },
      "neutral": {
        "root": "text-ink-muted/(--level-ink-muted)"
      },
      "on-accent": {
        "root": "text-primary-content"
      }
    }
  },
  "defaultVariants": {
    "tone": "accent"
  }
}
