{
  "component": "ArenaSpinner",
  "slots": {
    "root": "inline-flex",
    "circle": "arena-spinner inline-block border-[length:var(--bw-strong)] border-current border-t-transparent rounded-pill"
  },
  "variants": {
    "tone": {
      "accent": { "root": "text-primary" },
      "gold": { "root": "text-secondary" },
      "neutral": { "root": "text-ink-muted/62" },
      "on-accent": { "root": "text-primary-content" }
    },
    "size": {
      "sm": { "circle": "size-icon-sm" },
      "md": { "circle": "size-5" },
      "lg": { "circle": "size-8" }
    }
  },
  "defaultVariants": { "tone": "accent", "size": "md" }
}
