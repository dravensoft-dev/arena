{
  "component": "ArenaStepper",
  "answers": [
    {
      "family": "orientation",
      "options": [
        "arena-orientation-horizontal",
        "arena-orientation-vertical"
      ],
      "default": "arena-orientation-horizontal"
    }
  ],
  "slots": {
    "root": "relative flex [flex-direction:var(--arena-orientation-direction,row)] gap-inline list-none m-0 p-0",
    "step": "block flex-1 min-w-0",
    "trigger": "flex flex-wrap items-start gap-control w-full min-h-ctl-h-sm min-w-ctl-h-sm rounded-control text-start font-body focus-visible:outline-none focus-visible:ring-[length:var(--bw-focus)] focus-visible:ring-edge-focus bg-[color:var(--navigation-item-fill-rest,transparent)]",
    "rail": "flex [flex-direction:var(--arena-orientation-direction,row)] items-center self-stretch gap-inline shrink-0 basis-[var(--arena-orientation-rule-w,100%)]",
    "marker": "inline-flex flex-none items-center justify-center size-ctl-h-sm rounded-pill border-[length:var(--bw-control)] font-mono tabular-nums text-ctl-xs",
    "icon": "inline-flex text-[length:var(--icon-sm)]",
    "text": "flex flex-col justify-center min-w-0 min-h-ctl-h-sm grow basis-[var(--arena-orientation-rule-w,100%)]",
    "label": "font-face-label text-ctl-xs tracking-label-role case-label",
    "description": "font-body text-ctl-sm text-ink-muted/(--level-ink-muted)",
    "name": "sr-only",
    "connector": "grow basis-6 w-[var(--arena-orientation-rule-w,100%)] h-[var(--arena-orientation-rule-h,var(--bw-separator))] bg-[color:var(--surfaces-separator-edge-rest,var(--edge-separator))]"
  },
  "kind": {
    "root": "none",
    "step": "none",
    "trigger": "control",
    "rail": "none",
    "marker": "none",
    "icon": "none",
    "text": "none",
    "label": "none",
    "description": "none",
    "name": "none",
    "connector": "none"
  },
  "internal": {
    "state": "complete, current or upcoming, derived from index: the steps before it are complete and the ones after it upcoming",
    "reachable": "the step is a button: the stepper is interactive and the step lies behind the current one"
  },
  "variants": {
    "state": {
      "complete": {
        "label": "text-[color:color-mix(in_oklab,var(--steps-complete-label-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)]",
        "marker": "bg-[color:var(--steps-complete-marker-fill-rest,transparent)] border-[color:var(--steps-complete-marker-edge-rest,var(--edge-control-quiet))] text-[color:color-mix(in_oklab,var(--steps-complete-marker-ink-rest,var(--ink-body))_var(--level-ink-body),transparent)]"
      },
      "current": {
        "label": "font-bold text-[color:var(--steps-current-label-ink-rest,var(--ink-heading))]",
        "marker": "bg-[color:var(--steps-current-marker-fill-rest,var(--emphasis-primary-fill))] border-[color:var(--steps-current-marker-edge-rest,var(--emphasis-primary-edge))] text-[color:var(--steps-current-marker-ink-rest,var(--emphasis-primary-ink))]"
      },
      "upcoming": {
        "label": "text-[color:color-mix(in_oklab,var(--steps-upcoming-label-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]",
        "marker": "bg-[color:var(--steps-upcoming-marker-fill-rest,transparent)] border-[color:var(--steps-upcoming-marker-edge-rest,var(--edge-control))] text-[color:color-mix(in_oklab,var(--steps-upcoming-marker-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)]"
      }
    },
    "error": {
      "true": {
        "marker": "bg-[color:var(--steps-error-marker-fill-rest,transparent)] border-[color:var(--steps-error-marker-edge-rest,var(--hue-danger-edge))] text-[color:var(--steps-error-marker-ink-rest,var(--hue-danger-ink))]"
      },
      "false": {}
    },
    "reachable": {
      "true": {
        "trigger": "cursor-pointer hover:bg-[color:var(--navigation-item-fill-hover,var(--fill-hover))] active:bg-[color:var(--navigation-item-fill-pressed,color-mix(in_oklab,var(--navigation-item-fill-rest,transparent),color-mix(in_oklab,var(--navigation-item-ink-rest,var(--ink-muted))_var(--level-ink-muted),transparent)_calc(var(--mix-pressed)*100%)))]"
      },
      "false": {
        "trigger": "cursor-default"
      }
    }
  },
  "defaultVariants": {
    "state": "upcoming",
    "error": false,
    "reachable": false
  }
}
