{
  "component": "ArenaMenu",
  "transparent": {
    "root": "the trigger is the adopter's own control and the wrapper draws nothing around it, so a box class on the wrapper or above it decides the trigger's box as it decides the wrapper's"
  },
  "answers": [
    "fill"
  ],
  "slots": {
    "root": "inline-flex w-[var(--arena-fill-width,fit-content)]",
    "panel": "arena-menu z-dropdown min-w-50 p-1.5 bg-surface-floating border-[length:var(--bw-surface)] border-edge-surface-floating rounded-surface-floating shadow-surface-floating",
    "item": "flex items-center gap-2.5 w-full min-h-row-min text-left px-[calc(var(--sp-1)*2.5*var(--dz-row-scale-x))] py-[calc(var(--pad-control-y)*var(--dz-row-scale-y))] border-none rounded-control bg-transparent font-body text-md shadow-control-rest active:scale-[var(--press-scale)] motion-reduce:active:scale-100",
    "icon": "inline-flex text-[length:var(--icon-md)]",
    "label": "flex-1",
    "shortcut": "font-mono text-ctl-xs text-ink-muted/(--level-ink-muted)",
    "divider": "h-px my-1 bg-edge-separator",
    "header": "font-face-label text-label tracking-label-role case-label text-ink-muted/(--level-ink-muted) px-[calc(var(--sp-1)*2.5*var(--dz-row-scale-x))] pt-[calc(var(--sp-1)*2*var(--dz-row-scale-y))] pb-[calc(var(--sp-1)*var(--dz-row-scale-y))]"
  },
  "kind": {
    "root": "none",
    "panel": "floating",
    "item": "row",
    "icon": "none",
    "label": "none",
    "shortcut": "none",
    "divider": "none",
    "header": "row"
  },
  "internal": {
    "anchored": "the panel is positioned by the layer's overlay rather than by CSS"
  },
  "variants": {
    "anchored": {
      "false": {
        "root": "relative",
        "panel": "absolute top-full left-0 mt-1.5"
      },
      "true": {}
    },
    "align": {
      "start": {},
      "end": {
        "panel": "left-auto right-0"
      }
    },
    "disabled": {
      "true": {},
      "false": {}
    },
    "destructive": {
      "true": {},
      "false": {}
    }
  },
  "compoundVariants": [
    {
      "disabled": true,
      "class": {
        "item": "text-ink-muted/(--level-ink-muted) opacity-60 cursor-not-allowed"
      }
    },
    {
      "disabled": false,
      "destructive": true,
      "class": {
        "item": "cursor-pointer text-[color:var(--arena-hue-ink)] hover:bg-hover"
      }
    },
    {
      "disabled": false,
      "destructive": false,
      "class": {
        "item": "cursor-pointer text-ink-body/(--level-ink-body) hover:bg-primary/14"
      }
    }
  ],
  "defaultVariants": {
    "anchored": false,
    "align": "start",
    "disabled": false,
    "destructive": false
  },
  "hues": {
    "destructive": {
      "true": "danger",
      "false": null
    }
  }
}
