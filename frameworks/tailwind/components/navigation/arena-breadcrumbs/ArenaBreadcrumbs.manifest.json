{
  "component": "ArenaBreadcrumbs",
  "slots": {
    "root": "flex items-center flex-wrap gap-inline",
    "crumb": "font-face-label text-ctl-sm tracking-mono-nav text-ink-muted/62 no-underline",
    "current": "font-face-label text-ctl-sm tracking-mono-nav text-ink-body font-bold",
    "separator": "font-face-label text-ctl-sm text-neutral"
  },
  "variants": {
    "linked": {
      "true": {
        "crumb": "cursor-pointer transition-[color] duration-[var(--dur-hover)] ease-hover hover:text-ink-body/82"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "linked": true
  }
}
