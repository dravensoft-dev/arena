{
  "component": "ArenaBreadcrumbs",
  "slots": {
    "root": "flex items-center flex-wrap gap-inline",
    "crumb": "font-face-label text-trail tracking-trail text-ink-muted/(--level-ink-muted) no-underline",
    "current": "font-face-label text-trail tracking-trail text-ink-body font-bold",
    "separator": "font-face-label text-trail tracking-trail text-ink-muted/(--level-ink-muted)"
  },
  "variants": {
    "linked": {
      "true": {
        "crumb": "cursor-pointer transition-[color] duration-[var(--dur-hover)] ease-hover hover:text-ink-body/(--level-ink-body)"
      },
      "false": {}
    }
  },
  "defaultVariants": {
    "linked": true
  }
}
